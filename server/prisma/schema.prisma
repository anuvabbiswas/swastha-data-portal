generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum Role {
  ADMIN
  MARKETING
  COMMUNITY
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum FormType {
  MARKETING
  COMMUNITY
}

enum InputType {
  TEXT
  NUMBER
  DATE
  DROPDOWN
  MULTI_SELECT
  YES_NO
  UPLOAD_MEDIA
}

// 1. Users Table

model User {
  id           String     @id @default(uuid())
  employeeId   String     @unique 
  name         String
  passwordHash String 
  role         Role
  status       UserStatus @default(ACTIVE) 
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  submissions Submission[]
}

// 2. Field Definitions Table

model FieldDefinition {
  id           String    @id @default(uuid())
  formType     FormType 
  fieldLabel   String 
  description  String?
  inputType    InputType
  isRequired   Boolean   @default(false)
  options      Json? 
  displayOrder Int       @default(0) 
  isActive     Boolean   @default(true) 
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  allowOther   Boolean   @default(false)
}

// 3. Submissions Table
model Submission {
  id                  String   @id @default(uuid())
  
  associateId         String?  
  associate           User?    @relation(fields: [associateId], references: [id], onDelete: SetNull)
  associateName       String   @default("Unknown Associate")
  associateEmployeeId String   @default("UNKNOWN-ID")
  formType            String
  submissionData      Json
  schemaSnapshot      Json
  submittedAt         DateTime @default(now())
  isEdited            Boolean  @default(false)
  updatedAt           DateTime @default(now()) @updatedAt
}