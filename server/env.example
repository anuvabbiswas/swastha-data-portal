# Copy this file to `.env` in the same directory (server/.env) and fill in real values.
#   cp .env.example .env
# ==============================================================================


# --- Database -----------------------------------------------------------------

# MySQL connection string for the main application database.
# Format: mysql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL="mysql://username:password@localhost:3306/swastha_db"

# Used ONLY by Prisma's development migration engine (`prisma migrate dev`)
# to safely test schema changes against a disposable shadow database.
# NOT required in production — omit this variable entirely on production
# deployments (e.g. Hostinger), since `prisma migrate deploy` doesn't use it.
SHADOW_DATABASE_URL="mysql://username:password@localhost:3306/swastha_shadow_db"


# --- Server ---------------------------------------------------------------------

# Port the Express server listens on.
PORT=5000

# Set to "production" on live deployments. Affects error message verbosity
# (production hides internal error details from API responses) and may
# affect npm's install behavior (devDependencies) depending on your host.
NODE_ENV=development


# --- Authentication ---------------------------------------------------------------

# Secret key used to sign and verify JWTs. Must be a long, random string —
# do NOT use a short or guessable value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-generated-string"

# How long an issued JWT remains valid before requiring re-login.
# Examples: "8h", "1d", "7d"
JWT_EXPIRES_IN="8h"


# --- Frontend / CORS ---------------------------------------------------------------

# The origin the frontend is served from. Used to restrict CORS in server.js.
# In local development, this matches Vite's dev server (default port 5173).
# In production, since the backend serves the built frontend directly from
# the same origin, this is less critical but should still be set to your
# actual production domain for correctness.
CLIENT_URL="http://localhost:5173"
